# =============================================================================
# go-admin 生产环境变量模板（systemd EnvironmentFile）
# =============================================================================
# 安装（以 root 执行；systemd 由 PID 1 以 root 读取本文件，无需给服务用户读权限）：
#   sudo cp deploy/go-admin.env.example /opt/go-admin/go-admin.env
#   sudo chmod 600 /opt/go-admin/go-admin.env
#   sudo vi /opt/go-admin/go-admin.env        # 填入真实密码/密钥
#   sudo systemctl restart go-admin
#
# 语法限制（systemd EnvironmentFile，不是 shell 脚本）：
#   - 不支持 export、不支持 $(...) 命令替换、不支持 ${VAR} 变量展开
#   - 每行 KEY=value；值不要加引号，引号会被当成值的一部分
#   - # 开头为注释，空行忽略
#
# 环境变量覆盖规则：APP_ + 下划线分隔的大写配置路径
#   mysql.password  → APP_MYSQL_PASSWORD
#   server.port     → APP_SERVER_PORT
#
# ⚠ 关键约束：这里的键必须同时存在于 config/config.yaml 中（值可以是空串）。
#   viper 的 AutomaticEnv + Unmarshal 只对「配置文件里已声明的键」生效 ——
#   文件里没有的键，这里设了也会被静默忽略，不报错。
#   实测：config.yaml 缺 logger 段时，APP_LOGGER_FORMAT=json 无效，日志仍是 console。
#   原因与排查见 docs/deploy-native.md。

# ---- 必填：不填应用会在 config.Validate() 阶段失败退出 ----
APP_MYSQL_PASSWORD=改成你的真实密码
APP_JWT_SECRET=改成足够长的随机串

# ---- 敏感项：config.yaml 里留空，只在这里填 ----
# APP_REDIS_PASSWORD=
# APP_RABBITMQ_URL=amqp://user:pass@127.0.0.1:5672/

# ---- 中间件连接目标：默认复用本机已有实例，一般无需覆盖 ----
# config.yaml 默认值即 127.0.0.1:3306 / 127.0.0.1:6379。
# 若复用别的库名或远程中间件，改这里（同样要保证 config.yaml 里有这些键）。
# APP_MYSQL_HOST=127.0.0.1
# APP_MYSQL_PORT=3306
# APP_MYSQL_DBNAME=go
# APP_MYSQL_USERNAME=root

# ---- 日志：生产建议 json，便于采集；console 带颜色，只在终端看舒服 ----
APP_LOGGER_FORMAT=json
APP_LOGGER_LEVEL=info

# ---- 注册风控（公网/演示环境建议开启；config.yaml 里必须有 auth 段）----
# 设置后 /user/register 必须携带 invite_code，前端会自动显示邀请码输入框。
# APP_AUTH_REGISTER_INVITE_CODE=请换成随机邀请码

# ---- 体验 Demo（面试演示用；需先运行 seed 写入种子数据）----
# 开启后登录页显示「体验 Demo」按钮，POST /user/demo-login 免密登录 demo 账号。
# APP_DEMO_ENABLED=true
# APP_DEMO_USERNAME=demo

# ---- 多实例标识：RabbitMQ 队列名会拼成 <rabbitmq.queue>.<INSTANCE_ID> ----
# 不设则退化为 <hostname>-<pid>，单实例部署也无妨。
INSTANCE_ID=prod-1

# ---- 时区：MySQL DSN 用 loc=Local，不设会按 UTC 解析时间 ----
# 依赖系统 /usr/share/zoneinfo（本项目未引入 time/tzdata 兜底）。
TZ=Asia/Shanghai

# ---- 可选：Go GC 软内存上限，需与 systemd 单元里的 Environment= 保持一致 ----
# GOMEMLIMIT=256MiB
