{
  "title": "go-admin Chat Reliability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Online Connections",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "chat_online_connections", "legendFormat": "online" }
      ]
    },
    {
      "type": "stat",
      "title": "Outbox Pending",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "chat_outbox_pending", "legendFormat": "pending" }
      ]
    },
    {
      "type": "stat",
      "title": "Outbox Failed",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "chat_outbox_failed", "legendFormat": "failed" }
      ]
    },
    {
      "type": "stat",
      "title": "Consumer Failures 5m",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "increase(chat_consumer_failed_total[5m])", "legendFormat": "failures" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "chat_outbox_pending", "legendFormat": "pending" },
        { "expr": "chat_outbox_processing", "legendFormat": "processing" },
        { "expr": "chat_outbox_failed", "legendFormat": "failed" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(chat_consumer_succeeded_total[1m])", "legendFormat": "success/s" },
        { "expr": "rate(chat_consumer_failed_total[1m])", "legendFormat": "failed/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Push",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(chat_push_delivered_total[1m])", "legendFormat": "delivered/s" },
        { "expr": "rate(chat_push_dropped_slow_total[1m])", "legendFormat": "slow drops/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Online Connections",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "chat_online_connections", "legendFormat": "online" }
      ]
    }
  ]
}
